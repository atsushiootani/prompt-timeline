# Some global gitignore files exclude bin/ - here bin/ is the tool itself.
!bin/
!bin/*.mjs

# Generated output: contains your prompts verbatim, so never publish it.
out/
*.html
!view/template.html

# Your own config (the committed example is config/agents.example.json)
config/agents.json
*.local.json

node_modules/

.DS_Store
